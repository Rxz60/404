<!DOCTYPE html>
<html>
<head>
    <title>Discord Server Manager</title>
    <style>
        body { font-family: Arial, sans-serif; }
        .container { width: 50%; margin: 0 auto; }
        input, button { width: 100%; padding: 10px; margin: 5px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Discord Server Manager</h1>
        <input type="text" id="token" placeholder="Enter your bot token here">
        <button onclick="start()">Start</button>
        <div id="servers"></div>
    </div>

    <script>
        async function start() {
            const token = document.getElementById('token').value;
            const response = await fetch('https://discord.com/api/v9/users/@me/guilds', {
                headers: { 'Authorization': `Bot ${token}` }
            });
            const servers = await response.json();
            displayServers(servers);
        }

        function displayServers(servers) {
            const container = document.getElementById('servers');
            servers.forEach(server => {
                const div = document.createElement('div');
                div.innerHTML = `<strong>${server.name}</strong> (ID: ${server.id})`;
                container.appendChild(div);
            });
        }
    </script>
</body>
</html>
