local function GetClosestEnemy()
    local closestPlayer = nil
    local shortestDistance = MaxDistance

    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local myPos = LocalPlayer.Character.HumanoidRootPart.Position

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isEnemy = true
            if LocalPlayer.Team ~= nil and player.Team ~= nil and LocalPlayer.Team == player.Team then
                isEnemy = false
            end

            if isEnemy and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local enemyPos = player.Character.HumanoidRootPart.Position
                local dist = (myPos - enemyPos).Magnitude

                if dist <= shortestDistance then
                    shortestDistance = dist
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

local function GiveBombLogic(targetPlayer)
    if not targetPlayer or not targetPlayer.Character or not LocalPlayer.Character then return end
    
    task.spawn(function()
        local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local savedPos = myHRP.CFrame
        
        while _G.GiveBombActive do
            RunService.Heartbeat:Wait()
            if targetPlayer and targetPlayer.Character and LocalPlayer.Character then
                local tH = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                local mH = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                
                if tH and mH then
                    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if tool then 
                        local freq = 40
                        local dist = 6 + (math.sin(tick() * freq) * 6)
                        mH.Velocity = Vector3.new(0,0,0)
                        mH.CFrame = tH.CFrame * CFrame.new(0, 1, dist) 
                    end
                end
            else 
                break 
            end
        end
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = savedPos
        end
    end)
end

GiveBombBtn.MouseButton1Click:Connect(function()
    _G.GiveBombActive = not _G.GiveBombActive
    if _G.GiveBombActive then
        GiveBombBtn.BackgroundColor3 = Color3.fromRGB(35, 185, 75)
        local enemy = GetClosestEnemy()
        if enemy then
            GiveBombLogic(enemy)
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    GiveBombLogic(p)
                    break
                end
            end
        end
    else
        GiveBombBtn.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
    end
end)

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character then
        for _, obj in pairs(LocalPlayer.Character:GetDescendants()) do
            if obj:IsA("BasePart") and (string.find(obj.Name:lower(), "molotov") or string.find(obj.Name:lower(), "grenade") or string.find(obj.Name:lower(), "bomb")) then
                obj.Color = Color3.fromRGB(255, 255, 255)
                local light = obj:FindFirstChild("RedBombLight") or Instance.new("PointLight", obj)
                light.Name = "RedBombLight"
                light.Color = Color3.fromRGB(255, 0, 0)
                light.Brightness = 12
                light.Range = 12
                obj.Color = Color3.fromRGB(255, 20, 20)
            end
        end
    end

    if AutoTrackEnabled then
        local targetEnemy = GetClosestEnemy()
        if targetEnemy and targetEnemy.Character and targetEnemy.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local enemyHRP = targetEnemy.Character.HumanoidRootPart
            local myHRP = LocalPlayer.Character.HumanoidRootPart
            local timeVal = tick() * SpinSpeed
            
            local offset = Vector3.new(math.cos(timeVal) * 3.5, 0, math.sin(timeVal) * 3.5)
            myHRP.CFrame = CFrame.new(enemyHRP.Position + offset, enemyHRP.Position)
            myHRP.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

